<?xml version="1.0" encoding="utf-8"?>
<!-- Preview image for Project Progress widget in the widget picker -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Parchment background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#f5e6cc" />
            <stroke android:width="1dp" android:color="#8b4513" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Title placeholder -->
    <item android:top="8dp" android:left="10dp" android:right="40dp" android:bottom="38dp">
        <shape android:shape="rectangle">
            <solid android:color="#6b4e31" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- Progress bar track -->
    <item android:top="28dp" android:left="10dp" android:right="10dp" android:bottom="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#e8d5b7" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- Progress bar fill (65%) - use clip drawable for percentage -->
    <item android:top="28dp" android:left="10dp" android:right="10dp" android:bottom="18dp">
        <clip
            android:clipOrientation="horizontal"
            android:gravity="left">
            <shape android:shape="rectangle">
                <solid android:color="#6b4e31" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
    <!-- Count text placeholder -->
    <item android:top="42dp" android:left="10dp" android:right="60dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#c4a882" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
