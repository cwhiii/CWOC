<?xml version="1.0" encoding="utf-8"?>
<!-- Preview image for Weather widget in the widget picker -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Parchment background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#f5e6cc" />
            <stroke android:width="1dp" android:color="#8b4513" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Sun/weather icon circle -->
    <item android:top="10dp" android:left="10dp" android:width="30dp" android:height="30dp">
        <shape android:shape="oval">
            <solid android:color="#d4af37" />
        </shape>
    </item>
    <!-- Temperature text placeholder -->
    <item android:top="12dp" android:left="48dp" android:right="10dp" android:bottom="48dp">
        <shape android:shape="rectangle">
            <solid android:color="#6b4e31" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <!-- Condition text placeholder -->
    <item android:top="48dp" android:left="10dp" android:right="20dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#c4a882" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
