<?xml version="1.0" encoding="utf-8"?>
<!-- Tooltip background matching Mobile_Web's .maps-title-tooltip:
     background: #fff8e1, border: 1px solid #8b5a2b, border-radius: 4px,
     box-shadow: 0 1px 4px rgba(0,0,0,0.15) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6FFF8E1" />
    <stroke
        android:width="1dp"
        android:color="#8B5A2B" />
    <corners android:radius="4dp" />
</shape>
