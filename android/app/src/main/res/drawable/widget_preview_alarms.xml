<?xml version="1.0" encoding="utf-8"?>
<!-- Preview image for Upcoming Alarms widget in the widget picker -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Parchment background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#f5e6cc" />
            <stroke android:width="1dp" android:color="#8b4513" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Alarm row 1 -->
    <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="52dp">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#fffaf0" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <!-- Countdown badge -->
            <item android:gravity="right|center_vertical" android:right="4dp" android:width="28dp" android:height="12dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6b4e31" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Alarm row 2 -->
    <item android:top="30dp" android:left="8dp" android:right="8dp" android:bottom="30dp">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#fffaf0" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:gravity="right|center_vertical" android:right="4dp" android:width="28dp" android:height="12dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6b4e31" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Alarm row 3 -->
    <item android:top="52dp" android:left="8dp" android:right="8dp" android:bottom="8dp">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#fffaf0" />
                    <corners android:radius="4dp" />
                </shape>
            </item>
            <item android:gravity="right|center_vertical" android:right="4dp" android:width="28dp" android:height="12dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6b4e31" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>
