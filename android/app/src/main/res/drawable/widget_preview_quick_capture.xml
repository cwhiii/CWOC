<?xml version="1.0" encoding="utf-8"?>
<!-- Preview image for Quick Capture widget in the widget picker -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Parchment background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#f5e6cc" />
            <stroke android:width="1dp" android:color="#8b4513" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Plus icon circle -->
    <item android:gravity="center" android:width="32dp" android:height="32dp">
        <shape android:shape="oval">
            <solid android:color="#6b4e31" />
        </shape>
    </item>
    <!-- Plus horizontal bar -->
    <item android:gravity="center" android:width="16dp" android:height="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#fffaf0" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <!-- Plus vertical bar -->
    <item android:gravity="center" android:width="3dp" android:height="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#fffaf0" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
