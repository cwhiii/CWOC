<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#fffaf0"
    android:layout_marginBottom="4dp"
    android:padding="0dp">

    <!-- Colored left border (category color set programmatically) -->
    <View
        android:id="@+id/item_category_border"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#6b4e31" />

    <!-- Content area -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Title row -->
        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#4a2c2a"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Metadata row: status icon, due date badge, priority marker -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical">

            <!-- Status icon -->
            <ImageView
                android:id="@+id/item_status_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:visibility="gone"
                android:contentDescription="Status" />

            <!-- Due date badge -->
            <TextView
                android:id="@+id/item_due_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#8b7355"
                android:textSize="11sp"
                android:visibility="gone" />

            <!-- Priority marker -->
            <TextView
                android:id="@+id/item_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="#8b4513"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
