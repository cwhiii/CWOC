<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".CwocApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CWOC"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CWOC">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen alarm activity (shows over lock screen) — Task 38.2 -->
        <activity
            android:name=".ui.screens.alerts.AlarmFiredActivity"
            android:exported="false"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.CWOC" />

        <!-- FileProvider for sharing exported files (CSV, JSON) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Remove default WorkManager initializer so Hilt's custom one is used -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

        <!-- Notification alarm receiver (fires when AlarmManager triggers) -->
        <receiver
            android:name=".notification.AlarmReceiver"
            android:exported="false" />

        <!-- Email notification action receiver (Trash, Archive, Mark Read, Snooze buttons) -->
        <receiver
            android:name=".notification.EmailNotificationActionReceiver"
            android:exported="false" />

        <!-- Boot receiver to re-register alarms after device reboot -->
        <receiver
            android:name=".notification.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Today Calendar Widget -->
        <receiver
            android:name=".widget.calendar.TodayCalendarWidgetProvider"
            android:label="Today's Calendar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_calendar_info" />
        </receiver>

        <!-- Upcoming Tasks Widget -->
        <receiver
            android:name=".widget.tasks.UpcomingTasksWidgetProvider"
            android:label="Upcoming Tasks"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_tasks_info" />
        </receiver>

        <!-- Omni View Widget -->
        <receiver
            android:name=".widget.omniview.OmniViewWidgetProvider"
            android:label="Omni View"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_omni_view_info" />
        </receiver>

        <!-- Quick Capture Widget -->
        <receiver
            android:name=".widget.quickcapture.QuickCaptureWidgetProvider"
            android:label="New Chit"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_capture_info" />
        </receiver>

        <!-- Checklist Widget -->
        <receiver
            android:name=".widget.checklist.ChecklistWidgetProvider"
            android:label="Checklist"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_checklist_info" />
        </receiver>

        <!-- Upcoming Alarms Widget -->
        <receiver
            android:name=".widget.alarms.UpcomingAlarmsWidgetProvider"
            android:label="Upcoming Alarms"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_alarms_info" />
        </receiver>

        <!-- Project Progress Widget -->
        <receiver
            android:name=".widget.progress.ProjectProgressWidgetProvider"
            android:label="Project Progress"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_project_progress_info" />
        </receiver>

        <!-- Weather Widget -->
        <receiver
            android:name=".widget.weather.WeatherWidgetProvider"
            android:label="Weather"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <!-- Weekly Overview Widget -->
        <receiver
            android:name=".widget.weekly.WeeklyOverviewWidgetProvider"
            android:label="Weekly Overview"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weekly_overview_info" />
        </receiver>

        <!-- HST Time Bar Widget -->
        <receiver
            android:name=".widget.hstbar.HstTimeBarWidgetProvider"
            android:label="HST Time"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hst_bar_info" />
        </receiver>

        <!-- Checklist Widget Config Activity -->
        <activity
            android:name=".widget.checklist.ChecklistWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.CWOC.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Project Progress Widget Config Activity -->
        <activity
            android:name=".widget.progress.ProjectProgressConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.CWOC.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Weather Widget Config Activity -->
        <activity
            android:name=".widget.weather.WeatherWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.CWOC.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Quick Capture Menu Activity (transparent overlay) -->
        <activity
            android:name=".widget.quickcapture.QuickCaptureMenuActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.CWOC.Transparent" />

        <!-- Omni View RemoteViews Service -->
        <service
            android:name=".widget.omniview.OmniViewRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Checklist RemoteViews Service -->
        <service
            android:name=".widget.checklist.ChecklistRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Sync Foreground Service (keeps WebSocket alive for real-time sync) -->
        <service
            android:name=".data.sync.SyncForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>
