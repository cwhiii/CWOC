# C.W.'s O-POD Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://cwopod:cwopod@db:5432/cwopod

# Redis (task queue broker + session store)
REDIS_URL=redis://redis:6379/0

# Storage backend: "local" or "s3"
STORAGE_BACKEND=local
STORAGE_PATH=/app/storage

# S3-compatible storage (only if STORAGE_BACKEND=s3)
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Local AI services (leave empty to disable)
OLLAMA_URL=http://ollama:11434
COMFYUI_URL=http://comfyui:8188

# Source service: comma-separated provider IDs to disable (e.g., "gutenberg,standard_ebooks")
SOURCE_PROVIDERS_DISABLED=

# Application URL (used for QR codes in printed books)
APP_URL=http://localhost:8080

# Secret key for session encryption and credential storage
SECRET_KEY=change-me-to-a-random-64-char-string

# Session expiry in minutes
SESSION_EXPIRY_MINUTES=1440
