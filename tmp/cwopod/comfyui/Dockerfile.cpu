FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# System dependencies
RUN apt-get update && apt-get install -y \
    git \
    wget \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Clone ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /app

# Install Python dependencies — CPU-only PyTorch
RUN pip3 install --no-cache-dir torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu
RUN pip3 install --no-cache-dir -r requirements.txt

# Create model directories
RUN mkdir -p /app/models/checkpoints /app/models/vae /app/output

# Expose ComfyUI port
EXPOSE 8188

# Run ComfyUI — listen on all interfaces, CPU mode
# --preview-method auto: sends latent preview images via WebSocket at each sampling step
CMD ["python3", "main.py", "--listen", "0.0.0.0", "--port", "8188", "--cpu", "--preview-method", "auto"]
